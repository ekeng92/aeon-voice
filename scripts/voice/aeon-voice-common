#!/bin/zsh
# aeon-voice-common — Shared functions for the AEON Voice system.
# Sourced by all voice scripts. Do not execute directly.

FLAG_FILE="$HOME/.aeon-voice-enabled"
CONFIG_FILE="$HOME/.aeon-voice-config.json"
SOUND_ON="/System/Library/Sounds/Glass.aiff"
SOUND_OFF="/System/Library/Sounds/Funk.aiff"

ensure_voice_flag() {
  local current=""
  if [[ -f "$FLAG_FILE" ]]; then
    current="$(tr -d '[:space:]' < "$FLAG_FILE" 2>/dev/null)"
  fi
  case "$current" in
    on|off) ;;
    *)
      printf 'on\n' > "$FLAG_FILE"
      chmod 600 "$FLAG_FILE" 2>/dev/null || true
      ;;
  esac
}

voice_flag_value() {
  ensure_voice_flag
  tr -d '[:space:]' < "$FLAG_FILE"
}

voice_enabled() {
  [[ "$(voice_flag_value)" == "on" ]]
}

set_voice_flag() {
  local value="$1"
  printf '%s\n' "$value" > "$FLAG_FILE"
  chmod 600 "$FLAG_FILE" 2>/dev/null || true
}

play_voice_state_sound() {
  local state="$1"
  local sound_file=""
  case "$state" in
    on)  sound_file="$SOUND_ON" ;;
    off) sound_file="$SOUND_OFF" ;;
    *)   return 0 ;;
  esac
  if [[ -f "$sound_file" ]]; then
    /usr/bin/afplay "$sound_file" >/dev/null 2>&1 &!
  fi
}

teams_call_active() {
  pmset -g assertions 2>/dev/null | grep -q "Microsoft Teams Call in progress"
}

edge_tts_available() {
  command -v python3 >/dev/null 2>&1 || return 1
  python3 -c "import edge_tts" >/dev/null 2>&1
}

# Read a value from the JSON config file using python3 for safe parsing.
# Usage: read_config_value <key> <default>
read_config_value() {
  local key="$1"
  local default_val="$2"
  if [[ -f "$CONFIG_FILE" ]]; then
    local val
    val="$(python3 -c "
import json, sys
try:
    with open('$CONFIG_FILE') as f:
        cfg = json.load(f)
    v = cfg.get('$key')
    if v is not None:
        print(v if not isinstance(v, bool) else str(v).lower())
    else:
        sys.exit(1)
except Exception:
    sys.exit(1)
" 2>/dev/null)" && { echo "$val"; return; }
  fi
  echo "$default_val"
}

# Truncate message to max characters from config (0 = unlimited).
apply_max_chars() {
  local message="$1"
  local max_chars
  max_chars="$(read_config_value maxCharacters 0)"
  if [[ "$max_chars" -gt 0 && ${#message} -gt $max_chars ]]; then
    echo "${message:0:$max_chars}"
  else
    echo "$message"
  fi
}

# Send a macOS notification if notificationMode is not "off" in config.
# Fails silently — notification errors never block voice output.
maybe_notify() {
  local message="$1"
  local session="${2:-}"
  local prompt="${3:-}"
  local notify_mode
  notify_mode="$(read_config_value notificationMode off)"
  [[ "$notify_mode" != "off" ]] || return 0

  # Append to notification log (JSONL) — the menu bar app watches this file
  # and posts native macOS notifications via UNUserNotificationCenter.
  python3 -c '
import json, sys, os, time
entry = {"ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "msg": sys.argv[1]}
if len(sys.argv) > 2 and sys.argv[2]:
    entry["session"] = sys.argv[2]
if len(sys.argv) > 3 and sys.argv[3]:
    entry["prompt"] = sys.argv[3]
path = os.path.expanduser("~/.aeon-voice-notifications.jsonl")
with open(path, "a") as f:
    f.write(json.dumps(entry) + "\n")
' "$message" "$session" "$prompt" 2>/dev/null || true
}

speak_edge_tts() {
  local voice="$1"
  local rate="$2"
  local message="$3"
  local session="${4:-}"
  local prompt="${5:-}"

  [[ -n "$message" ]] || return 0
  voice_enabled || return 0

  # Check meeting auto-mute (configurable per service)
  local mute_teams
  mute_teams="$(read_config_value muteOnTeams true)"
  if [[ "$mute_teams" == "true" ]]; then
    teams_call_active && return 0
  fi

  # Apply max character limit from config
  message="$(apply_max_chars "$message")"

  edge_tts_available || return 0

  local lock_file="$HOME/.aeon-voice-queue.lock"

  # Fully detach into its own process. &! (zsh disown) makes it immune
  # to terminal death — the voice plays even if the terminal is killed.
  #
  # Two-phase pipeline:
  #   Phase 1 (unlocked): Generate audio to a temp file. Multiple voices
  #     can generate concurrently while a previous voice is still playing.
  #   Phase 2 (locked):   Play the pre-generated file under lockf. Only
  #     one voice plays at a time, but there's no gap because the next
  #     voice's audio was already generated during the previous playback.
  (
    # Clean up stale temp files from prior interrupted runs (older than 2 min)
    find /tmp -name 'aeon-voice-*' -mmin +2 -delete 2>/dev/null || true

    # Determine notification config once
    local notify_mode
    notify_mode="$(read_config_value notificationMode off)"

    # Phase 1: Pre-generate audio to temp file (NO LOCK — runs concurrently)
    local tmpbase
    tmpbase="$(mktemp /tmp/aeon-voice-XXXXXX)"
    local tmpmp3="${tmpbase}.mp3"

    if [[ -n "$rate" ]]; then
      python3 -m edge_tts --voice "$voice" --rate "$rate" --text "$message" --write-media "$tmpmp3" >/dev/null 2>&1
    else
      python3 -m edge_tts --voice "$voice" --text "$message" --write-media "$tmpmp3" >/dev/null 2>&1
    fi

    if [[ -s "$tmpmp3" ]]; then
      # Write notification before acquiring lock (no contention)
      if [[ "$notify_mode" != "off" ]]; then
        python3 -c '
import json, sys, os, time
entry = {"ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "msg": sys.argv[1]}
if len(sys.argv) > 2 and sys.argv[2]: entry["session"] = sys.argv[2]
if len(sys.argv) > 3 and sys.argv[3]: entry["prompt"] = sys.argv[3]
path = os.path.expanduser("~/.aeon-voice-notifications.jsonl")
with open(path, "a") as f: f.write(json.dumps(entry) + "\n")
' "$message" "$session" "$prompt" 2>/dev/null || true
      fi

      # Phase 2: Play under lock — only one voice at a time, zero gap
      if command -v ffplay >/dev/null 2>&1; then
        lockf -k -t 120 "$lock_file" ffplay -nodisp -autoexit -loglevel quiet "$tmpmp3"
      else
        lockf -k -t 120 "$lock_file" /usr/bin/afplay "$tmpmp3"
      fi
    fi

    rm -f "$tmpmp3" "$tmpbase"
  ) &!
}
