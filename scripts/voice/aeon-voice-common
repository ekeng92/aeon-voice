#!/bin/zsh
# aeon-voice-common — Shared functions for the AEON Voice system.
# Sourced by all voice scripts. Do not execute directly.

FLAG_FILE="$HOME/.aeon-voice-enabled"
CONFIG_FILE="$HOME/.aeon-voice-config.json"
SOUND_ON="/System/Library/Sounds/Glass.aiff"
SOUND_OFF="/System/Library/Sounds/Funk.aiff"

ensure_voice_flag() {
  local current=""
  if [[ -f "$FLAG_FILE" ]]; then
    current="$(tr -d '[:space:]' < "$FLAG_FILE" 2>/dev/null)"
  fi
  case "$current" in
    on|off) ;;
    *)
      printf 'on\n' > "$FLAG_FILE"
      chmod 600 "$FLAG_FILE" 2>/dev/null || true
      ;;
  esac
}

voice_flag_value() {
  ensure_voice_flag
  tr -d '[:space:]' < "$FLAG_FILE"
}

voice_enabled() {
  [[ "$(voice_flag_value)" == "on" ]]
}

set_voice_flag() {
  local value="$1"
  printf '%s\n' "$value" > "$FLAG_FILE"
  chmod 600 "$FLAG_FILE" 2>/dev/null || true
}

play_voice_state_sound() {
  local state="$1"
  local sound_file=""
  case "$state" in
    on)  sound_file="$SOUND_ON" ;;
    off) sound_file="$SOUND_OFF" ;;
    *)   return 0 ;;
  esac
  if [[ -f "$sound_file" ]]; then
    /usr/bin/afplay "$sound_file" >/dev/null 2>&1 &!
  fi
}

teams_call_active() {
  pmset -g assertions 2>/dev/null | grep -q "Microsoft Teams Call in progress"
}

edge_tts_available() {
  command -v python3 >/dev/null 2>&1 || return 1
  python3 -c "import edge_tts" >/dev/null 2>&1
}

# Read a value from the JSON config file.
# Usage: read_config_value <key> <default>
read_config_value() {
  local key="$1"
  local default_val="$2"
  if [[ -f "$CONFIG_FILE" ]]; then
    local val
    val="$(grep "\"$key\"" "$CONFIG_FILE" 2>/dev/null | head -1 | sed 's/.*: *//; s/["\,]//g; s/^ *//; s/ *$//')"
    if [[ -n "$val" ]]; then
      echo "$val"
      return
    fi
  fi
  echo "$default_val"
}

# Truncate message to max characters from config (0 = unlimited).
apply_max_chars() {
  local message="$1"
  local max_chars
  max_chars="$(read_config_value maxCharacters 0)"
  if [[ "$max_chars" -gt 0 && ${#message} -gt $max_chars ]]; then
    echo "${message:0:$max_chars}"
  else
    echo "$message"
  fi
}

# Send a macOS notification if showNotifications is enabled in config.
# Fails silently — notification errors never block voice output.
maybe_notify() {
  local message="$1"
  local session="${2:-}"
  local prompt="${3:-}"
  local notify_enabled
  notify_enabled="$(read_config_value showNotifications false)"
  [[ "$notify_enabled" == "true" ]] || return 0

  # Append to notification log (JSONL) — the menu bar app watches this file
  # and posts native macOS notifications via UNUserNotificationCenter.
  python3 -c '
import json, sys, os, time
entry = {"ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "msg": sys.argv[1]}
if len(sys.argv) > 2 and sys.argv[2]:
    entry["session"] = sys.argv[2]
if len(sys.argv) > 3 and sys.argv[3]:
    entry["prompt"] = sys.argv[3]
path = os.path.expanduser("~/.aeon-voice-notifications.jsonl")
with open(path, "a") as f:
    f.write(json.dumps(entry) + "\n")
' "$message" "$session" "$prompt" 2>/dev/null || true
}

speak_edge_tts() {
  local voice="$1"
  local rate="$2"
  local message="$3"
  local session="${4:-}"
  local prompt="${5:-}"

  [[ -n "$message" ]] || return 0
  voice_enabled || return 0

  # Check meeting auto-mute (configurable per service)
  local mute_teams
  mute_teams="$(read_config_value muteOnTeams true)"
  if [[ "$mute_teams" == "true" ]]; then
    teams_call_active && return 0
  fi

  # Apply max character limit from config
  message="$(apply_max_chars "$message")"

  edge_tts_available || return 0

  local lock_file="$HOME/.aeon-voice-queue.lock"

  # Fully detach TTS generation + playback into its own process.
  # &! (zsh: background + disown) makes it immune to terminal death —
  # the voice plays to completion even if the calling terminal is killed.
  #
  # lockf serializes concurrent voices into a FIFO queue. Each detached
  # process waits for the lock before generating + playing, so multiple
  # agents never talk over each other. Timeout of 120s prevents a hung
  # process from blocking the queue forever.
  (
    # Clean up stale temp files from prior interrupted runs (older than 2 min)
    find /tmp -name 'aeon-voice-*' -mmin +2 -delete 2>/dev/null || true

    # Determine notification config once (outside lock — no contention)
    local notify_enabled
    notify_enabled="$(read_config_value showNotifications false)"

    # Write the TTS+playback script to a temp file so lockf can execute it.
    # lockf needs a command to run; heredocs can't be passed directly.
    local play_script
    play_script="$(mktemp /tmp/aeon-voice-play-XXXXXX.sh)"
    chmod +x "$play_script"

    if command -v ffplay >/dev/null 2>&1; then
      # Streaming path: pipe TTS audio chunks directly to ffplay
      cat > "$play_script" << 'PYEOF_WRAPPER'
#!/bin/zsh
exec python3 - "$@" << 'PYEOF'
import asyncio, subprocess, sys, os, json, time
import edge_tts

async def main():
    voice, rate, message = sys.argv[1], sys.argv[2], sys.argv[3]
    notify = sys.argv[4] == "true"
    session = sys.argv[5] if len(sys.argv) > 5 else ""
    prompt = sys.argv[6] if len(sys.argv) > 6 else ""

    kwargs = {}
    if rate:
        kwargs["rate"] = rate
    communicate = edge_tts.Communicate(message, voice, **kwargs)

    proc = subprocess.Popen(
        ["ffplay", "-nodisp", "-autoexit", "-loglevel", "quiet", "-"],
        stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
    )
    has_audio = False
    async for chunk in communicate.stream():
        if chunk["type"] == "audio":
            has_audio = True
            try:
                proc.stdin.write(chunk["data"])
            except BrokenPipeError:
                break
    proc.stdin.close()

    if has_audio and notify:
        entry = {"ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "msg": message}
        if session:
            entry["session"] = session
        if prompt:
            entry["prompt"] = prompt
        path = os.path.expanduser("~/.aeon-voice-notifications.jsonl")
        with open(path, "a") as f:
            f.write(json.dumps(entry) + "\n")

    proc.wait()

asyncio.run(main())
PYEOF
PYEOF_WRAPPER

      lockf -k -t 120 "$lock_file" "$play_script" "$voice" "$rate" "$message" "$notify_enabled" "$session" "$prompt"
    else
      # Fallback: file-based generation + afplay (also queued)
      cat > "$play_script" << 'FALLBACK_WRAPPER'
#!/bin/zsh
voice="$1"; rate="$2"; message="$3"; notify_enabled="$4"; session="$5"; prompt="$6"

tmpbase="$(mktemp /tmp/aeon-voice-XXXXXX)"
tmpfile="${tmpbase}.mp3"

if [[ -n "$rate" ]]; then
  python3 -m edge_tts --voice "$voice" --rate "$rate" --text "$message" --write-media "$tmpfile" >/dev/null 2>&1
else
  python3 -m edge_tts --voice "$voice" --text "$message" --write-media "$tmpfile" >/dev/null 2>&1
fi

if [[ -s "$tmpfile" ]]; then
  if [[ "$notify_enabled" == "true" ]]; then
    python3 -c '
import json, sys, os, time
entry = {"ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "msg": sys.argv[1]}
if len(sys.argv) > 2 and sys.argv[2]: entry["session"] = sys.argv[2]
if len(sys.argv) > 3 and sys.argv[3]: entry["prompt"] = sys.argv[3]
path = os.path.expanduser("~/.aeon-voice-notifications.jsonl")
with open(path, "a") as f: f.write(json.dumps(entry) + "\n")
' "$message" "$session" "$prompt" 2>/dev/null || true
  fi
  /usr/bin/afplay "$tmpfile" >/dev/null 2>&1
fi

rm -f "$tmpfile" "$tmpbase"
FALLBACK_WRAPPER

      lockf -k -t 120 "$lock_file" "$play_script" "$voice" "$rate" "$message" "$notify_enabled" "$session" "$prompt"
    fi

    rm -f "$play_script"
  ) &!
}
