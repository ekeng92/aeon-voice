#!/bin/zsh
# AEON Voice — Default voice command (configurable via AEON Voice app)
# Reads voice settings from ~/.aeon-voice-config.json
# This is the command agents use. The voice is set in the menu bar app.

source "$HOME/.local/bin/aeon-voice-common"

voice="$(read_config_value defaultVoice "en-US-AndrewNeural")"
rate="$(read_config_value defaultRate "")"

# Parse optional flags
session=""
prompt=""
is_subagent=false
while [[ $# -gt 1 ]]; do
  case "$1" in
    --session|-s) session="$2"; shift 2 ;;
    --prompt|-p) prompt="$2"; shift 2 ;;
    --subagent) is_subagent=true; shift ;;
    *) break ;;
  esac
done

# If this is a subagent call, check config — exit silently if disabled
if [[ "$is_subagent" == "true" ]]; then
  subagent_allowed="$(read_config_value subagentVoice false)"
  if [[ "$subagent_allowed" != "true" ]]; then
    exit 0
  fi
  # Prefix session to indicate subagent origin in notifications
  session="↳ ${session}"
fi

speak_edge_tts "$voice" "$rate" "$1" "$session" "$prompt"
