#!/bin/zsh
# AEON Prime Voice — Neural TTS via edge-tts
# Voice: Andrew (en-US) — Calm, measured, steady.

source "$HOME/.local/bin/aeon-voice-common"

session=""
prompt=""
while [[ $# -gt 1 ]]; do
  case "$1" in
    --session|-s) session="$2"; shift 2 ;;
    --prompt|-p) prompt="$2"; shift 2 ;;
    *) break ;;
  esac
done

speak_edge_tts "en-US-AndrewNeural" "" "$1" "$session" "$prompt"
